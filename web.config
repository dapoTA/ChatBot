<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Security: block direct access to source files -->
    <!-- NOTE: Windows Authentication must be enabled via IIS Manager, not web.config.  -->
    <!-- IIS Manager → site → Authentication → Enable Windows Auth, Disable Anonymous.  -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="server" />
          <add segment="shared" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Tell iisnode which file is the Node.js entry point -->
    <handlers>
      <add name="iisnode" path="app.cjs" verb="*" modules="iisnode" />
    </handlers>

    <!-- iisnode settings -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      debuggingEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />

    <!-- URL Rewrite: forward all requests to Node, injecting Windows username as a header -->
    <rewrite>
      <!-- Permit URL Rewrite to stamp the IIS LOGON_USER server variable onto the request -->
      <allowedServerVariables>
        <add name="HTTP_X_LOGON_USER" />
      </allowedServerVariables>
      <rules>
        <!-- Skip iisnode log files from rewriting -->
        <rule name="Skip iisnode logs" stopProcessing="true">
          <match url="^iisnode_logs" />
          <action type="None" />
        </rule>

        <!-- Route everything else to app.cjs, forwarding LOGON_USER as X-Logon-User header -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <serverVariables>
            <!-- HTTP_ prefix causes IIS to expose this as a request header to Node -->
            <set name="HTTP_X_LOGON_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="app.cjs" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>

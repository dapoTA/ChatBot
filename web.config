<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Tell iisnode which file is the Node.js entry point -->
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- iisnode settings -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      debuggingEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
    />

    <!-- URL Rewrite: send all requests through Node/Express -->
    <rewrite>
      <rules>
        <!-- Skip iisnode log files from rewriting -->
        <rule name="Skip iisnode logs" stopProcessing="true">
          <match url="^iisnode_logs" />
          <action type="None" />
        </rule>

        <!-- Route everything else to app.js -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security: block direct access to source files -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="server" />
          <add segment="shared" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>

# ON-PNT® SharePoint ChatBot — Environment Variables (SQL Server / mssql branch)

# ─── Azure OpenAI ───────────────────────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://yourresource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── SQL Server ────────────────────────────────────────────────────────────────────────────────
MSSQL_HOST=your-sql-server-host
MSSQL_PORT=1433
MSSQL_DATABASE=chatbot
MSSQL_USER=sa
MSSQL_PASSWORD=your-sql-server-password
# Set to "true" to trust self-signed or internal CA certificates (recommended for on-premises)
MSSQL_TRUST_CERT=true

# ─── Session ───────────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
